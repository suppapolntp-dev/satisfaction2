# ==============================================================================
# Satisfaction Platform - Environment Variables Template (.env.example)
# Copy this file to .env and replace placeholder values with your secure secrets.
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=satisfaction_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=your_secure_postgres_password_here
POSTGRES_PORT=5432

# pgAdmin Web Management Console
PGADMIN_DEFAULT_EMAIL=admin@satisfaction.com
PGADMIN_DEFAULT_PASSWORD=your_secure_pgadmin_password_here
PGADMIN_PORT=5050
